<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ai-practice</artifactId>
        <groupId>com.czy.ai</groupId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>qwen</artifactId>
    <packaging>pom</packaging>
    <description>Qwen AI Service Parent Module</description>

    <modules>
        <module>qwen-common</module>
        <module>qwen-domain</module>
        <module>qwen-infrastructure</module>
        <module>qwen-service</module>
        <module>qwen-starter</module>
    </modules>

    <properties>
        <!-- Qwen 独有依赖版本 -->
        <okhttp.version>4.12.0</okhttp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Qwen Common Module -->
            <dependency>
                <groupId>com.czy.ai</groupId>
                <artifactId>qwen-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Qwen Domain Module -->
            <dependency>
                <groupId>com.czy.ai</groupId>
                <artifactId>qwen-domain</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Qwen Infrastructure Module -->
            <dependency>
                <groupId>com.czy.ai</groupId>
                <artifactId>qwen-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Qwen Service Module -->
            <dependency>
                <groupId>com.czy.ai</groupId>
                <artifactId>qwen-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Qwen Starter Module -->
            <dependency>
                <groupId>com.czy.ai</groupId>
                <artifactId>qwen-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OKHttp (Qwen 独有) -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>